<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- En-tête -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Téléchargeur Natif AimpE3"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Barre de saisie lien / recherche -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etUrlInput"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Coller le lien direct (ex: MP3/Audio)..."
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:background="#222222"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnNativeDownload"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Télécharger"
            android:backgroundTint="#1DB954"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Texte indicatif -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fichiers prêts à être récupérés :"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <!-- Liste des téléchargements natifs -->
    <ListView
        android:id="@+id/listViewNative"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#1A1A1A"
        android:dividerHeight="8dp"/>

</LinearLayout>

