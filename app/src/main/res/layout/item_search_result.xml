<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Top info row: Cover thumbnail + details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Cover Image with duration overlay -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#2C2C2C">

            <ImageView
                android:id="@+id/ivResultCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Pochette de l'album"
                android:src="@android:drawable/ic_media_play"/>

            <TextView
                android:id="@+id/tvResultDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:text="03:45"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#99000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"/>
        </FrameLayout>

        <!-- Song Metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom de la chanson"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvResultArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom de l'artiste"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

            <!-- Badges: Format & Source -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvResultQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MP3 320k"
                    android:textColor="#FFD54F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#33FFD54F"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"/>

                <TextView
                    android:id="@+id/tvResultSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jamendo"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Row (Snaptube-style buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnResultPreview"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="▶ Aperçu"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#2C2C2C"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnResultDownload"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.4"
            android:text="⬇ Télécharger MP3"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="12sp"
            android:backgroundTint="#FFCA28"
            android:layout_marginStart="8dp"
            android:padding="0dp"/>
    </LinearLayout>

</LinearLayout>
